---
import '~/styles/global.css'
import '~/styles/markdown.css'
import '~/styles/lqip.css'
import '~/styles/github-card.css'
import { SITE } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'

type Props = {
  title: string
  description: string
  image?: string
  disableViewTransition?: boolean
  blogPosting?: {
    headline: string
    description: string
    datePublished: string
    url: string
    image: string
    keywords: string[]
    authorUrl: string
  }
  softwareApplication?: {
    name: string
    operatingSystem: string
    applicationCategory: string
    codeRepository: string
    downloadUrl: string
  }
  citation?: {
    name: string
    url: string
    creator: string
  }
}

const { title, description, image, disableViewTransition, blogPosting, softwareApplication, citation }: Props = Astro.props
const softwareApplicationJson = softwareApplication ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": softwareApplication.name,
  "operatingSystem": softwareApplication.operatingSystem,
  "applicationCategory": softwareApplication.applicationCategory,
  "downloadUrl": softwareApplication.downloadUrl,
  "author": { "@type": "Person", "name": "Lionel Mosley", "url": "https://trust-lionel.com" }
}) : null
const softwareSourceCodeJson = softwareApplication ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": softwareApplication.name,
  "codeRepository": softwareApplication.codeRepository,
  "programmingLanguage": "Swift",
  "runtimePlatform": softwareApplication.operatingSystem,
  "author": { "@type": "Person", "name": "Lionel Mosley", "url": "https://trust-lionel.com" }
}) : null
const citationJson = citation ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "citation": {
    "@type": "CreativeWork",
    "name": citation.name,
    "url": citation.url,
    "creator": {
      "@type": "Organization",
      "name": citation.creator,
      "url": "https://4thandbailey.com"
    }
  }
}) : null
---

<!doctype html>
<html lang={SITE.lang} transition:name="root" transition:animate={SITE.transition && !disableViewTransition ? 'fade' : 'none'}>
  <head>
    <Head title={title ? `${title} | ${SITE.title}` : SITE.title} {description} {image} />
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-543DS8T7');</script>
    <!-- End Google Tag Manager -->
    <!-- Umami Analytics — cookieless, GDPR-compliant, self-hosted on Railway -->
    <script is:inline defer src="/stats/script.js" data-website-id="b8e2a312-e7f4-4595-95ee-38b47fc9be54"></script>
    <!-- Umami Session Replay Recorder -->
    <script is:inline defer src="/stats/recorder.js" data-website-id="b8e2a312-e7f4-4595-95ee-38b47fc9be54" data-sample-rate="0.15" data-mask-level="moderate" data-max-duration="300000"></script>
    <!-- Person + WebSite JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Lionel Mosley",
      "url": "https://trust-lionel.com",
      "image": "https://trust-lionel.com/og-image.png",
      "jobTitle": "Senior Consultant, IT Strategy Growth & Transformation",
      "description": "IT Consultant, Cloud Engineer, Innovative Thought Leader, and Subject Matter Expert specializing in cloud infrastructure, cybersecurity, Microsoft 365, and enterprise IT governance. Based in Houston, TX — serving organizations nationwide through 4TH AND BAILEY.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Houston",
        "addressRegion": "TX",
        "addressCountry": "US"
      },
      "worksFor": {
        "@type": "Organization",
        "name": "4TH AND BAILEY",
        "url": "https://4thandbailey.com"
      },
      "sameAs": [
        "https://trust-lionel.com",
        "https://linkedin.com/in/lionelmosley",
        "https://github.com/trust-lionel",
        "https://youtube.com/@LMosley002",
        "https://x.com/lionelmosley",
        "https://www.facebook.com/yourinfotechconsultant",
        "https://www.threads.com/@lionelmosley",
        "https://bsky.app/profile/ahr-ki-tekt.trust-lionel.com",
        "https://instagram.com/lionelmosley",
        "https://reddit.com/u/trust-lionel",
        "https://open.spotify.com/user/lmosley002-spotify",
        "https://about.me/lionelmosley",
        "https://blog.lionelmosley.com",
        "https://devops.houstonalert.com",
        "https://wordcards.co",
        "https://about.lionelmosley.com",
        "https://substack.com/@lionelmosley",
        "https://lionelmosley.substack.com",
        "https://gitlab.com/trust-lionel",
        "https://links.lionelmosley.com",
        "https://luma.com/user/lionelmosley",
        "https://www.goodreads.com/user/show/187124215-l-i-o-n-e-l"
      ],
      "knowsAbout": [
        "Cloud Infrastructure","Cloud Engineering","Cybersecurity","Microsoft 365",
        "Microsoft Azure","Amazon AWS","Google Workspace","Cloud Migration",
        "Cloud Repatriation","CISA SCuBA","NIST SP 800-53","MITRE ATT&CK",
        "CIS Benchmarks","HIPAA Compliance","CMMC","PCI-DSS",
        "Enterprise IT Governance","IT Consulting","Incident Response",
        "AI Governance","Business Continuity"
      ],
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Microsoft Cloud Solution Provider (CSP)",
          "credentialCategory": "Professional Certification",
          "recognizedBy": { "@type": "Organization", "name": "Microsoft", "url": "https://www.microsoft.com" }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Google Partner",
          "credentialCategory": "Professional Certification",
          "recognizedBy": { "@type": "Organization", "name": "Google", "url": "https://www.google.com" }
        }
      ]})} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Lionel Mosley | ahr-ki-tekt",
      "url": "https://trust-lionel.com",
      "description": "Carefully selected frameworks, insights, and solutions from Lionel Mosley — IT Consultant & Innovative Thought Leader based in Houston, TX.",
      "author": { "@type": "Person", "name": "Lionel Mosley", "url": "https://trust-lionel.com" },
      "inLanguage": "en-US"
    })} />
    <!-- LocalBusiness + ProfessionalService JSON-LD Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://trust-lionel.com/#LocalBusiness",
      "name": "4TH AND BAILEY",
      "alternateName": ["4th and Bailey", "m365cloudpro"],
      "description": "Enterprise IT consulting from Houston, TX. Authorized Microsoft Cloud Solution Provider, Google Partner, and creator of the Infrastructure Placement Framework. Cybersecurity governance, cloud migration, and IT strategy — CISA SCuBA and NIST aligned.",
      "url": "https://4thandbailey.com",
      "telephone": "+18883055977",
      "email": "inquiries@4thandbailey.com",
      "priceRange": "$$",
      "image": "https://trust-lionel.com/og-image.png",
      "openingHours": "Mo Tu We Th Fr 08:30-17:30",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2500 CityWest Blvd., Suite #150-165",
        "addressLocality": "Houston",
        "addressRegion": "TX",
        "postalCode": "77042",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 29.7355,
        "longitude": -95.5546
      },
      "areaServed": [
        { "@type": "City", "name": "Houston" },
        { "@type": "City", "name": "Sugar Land" },
        { "@type": "City", "name": "Pearland" },
        { "@type": "City", "name": "The Woodlands" },
        { "@type": "City", "name": "Katy" },
        { "@type": "City", "name": "Pasadena" },
        { "@type": "City", "name": "League City" },
        { "@type": "City", "name": "Baytown" },
        { "@type": "City", "name": "Friendswood" },
        { "@type": "City", "name": "Missouri City" },
        { "@type": "City", "name": "Stafford" },
        { "@type": "City", "name": "Conroe" },
        { "@type": "City", "name": "Humble" },
        { "@type": "City", "name": "Cypress" },
        { "@type": "City", "name": "Spring" },
        { "@type": "City", "name": "Brookshire" },
        { "@type": "City", "name": "Richmond" },
        { "@type": "City", "name": "Rosenberg" },
        { "@type": "AdministrativeArea", "name": "Greater Houston" },
        { "@type": "AdministrativeArea", "name": "Harris County" },
        { "@type": "AdministrativeArea", "name": "Fort Bend County" },
        { "@type": "AdministrativeArea", "name": "Montgomery County" },
        { "@type": "AdministrativeArea", "name": "Brazoria County" },
        { "@type": "State", "name": "Texas" },
        { "@type": "Country", "name": "United States" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "IT Consulting Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Microsoft 365 Licensing" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Microsoft Cloud Solution Provider" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Microsoft Azure Consulting" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Managed IT Services" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cybersecurity Governance" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud Migration" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cloud Repatriation" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "IT Strategy Consulting" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Incident Response" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Governance" } },
