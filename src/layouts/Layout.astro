          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Infrastructure Placement" } }
        ]
      },
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Microsoft Cloud Solution Provider",
          "credentialCategory": "Professional Certification",
          "recognizedBy": { "@type": "Organization", "name": "Microsoft", "url": "https://www.microsoft.com" }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Google Partner",
          "credentialCategory": "Professional Certification",
          "recognizedBy": { "@type": "Organization", "name": "Google", "url": "https://www.google.com" }
        }
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "10",
        "bestRating": "5",
        "worstRating": "1"
      },
      "founder": {
        "@type": "Person",
        "name": "Lionel Mosley",
        "url": "https://trust-lionel.com",
        "sameAs": "https://linkedin.com/in/lionelmosley"
      },
      "sameAs": [
        "https://4thandbailey.com",
        "https://m365cloudpro.com",
        "https://framework.4thandbailey.com",
        "https://github.com/4thandBailey",
        "https://www.linkedin.com/company/4thandbailey",
        "https://clutch.co/profile/4th-bailey",
        "https://appsource.microsoft.com/en-us/marketplace/partner-dir/22479281-ab81-4d69-ab39-e39bb2dde0a7/overview"
      ]
    })} />

    <!-- BlogPosting JSON-LD — injected on post pages only -->
    {blogPosting && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": blogPosting.headline,
        "description": blogPosting.description,
        "author": { "@type": "Person", "name": "Lionel Mosley", "url": blogPosting.authorUrl },
        "publisher": { "@type": "Organization", "name": "Lionel Mosley | ahr-ki-tekt", "url": "https://trust-lionel.com" },
        "datePublished": blogPosting.datePublished,
        "url": blogPosting.url,
        "image": blogPosting.image,
        "keywords": blogPosting.keywords
    })} />
    )}

    <!-- SoftwareApplication JSON-LD — injected on software post pages only -->
    {softwareApplicationJson && (
      <script is:inline type="application/ld+json" set:html={softwareApplicationJson} />
    )}
    <!-- SoftwareSourceCode JSON-LD — injected on software post pages only -->
    {softwareSourceCodeJson && (
      <script is:inline type="application/ld+json" set:html={softwareSourceCodeJson} />
    )}
    <!-- Citation JSON-LD — injected on post pages that reference the IPF or other CreativeWorks -->
    {citationJson && (
      <script is:inline type="application/ld+json" set:html={citationJson} />
    )}
  </head>
  <body class="flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-543DS8T7" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Header />
    <div class="grow flex">
      <main class="relative border-x border-border/50 global-layout-width mx-auto grow min-w-0">
        <slot />
      </main>
    </div>
    <Footer />
    <div
      class="safari-hidden pointer-events-none bg-white dark:bg-black fixed z-50 bottom-0 left-0 h-28 [mask-image:linear-gradient(transparent,#000000)] w-full"
    >
    </div>
  </body>
</html>
